node_modules/
dist/
.wrangler/
coverage/
worker-configuration.d.ts
*.tsbuildinfo
.DS_Store

# dotenvx: ignore every .env file by default, then allow exactly the three that are
# committed as ciphertext. Un-ignoring by name rather than dropping the .env rule keeps
# a stray plaintext .env anywhere else in the tree unstageable.
.env*
!apps/edge/.env
!apps/edge/.env.ci
!apps/edge/.env.production
!apps/agent/.env.example
.env.keys
.env.keys.*
.env*.local
.dev.vars
.dev.vars.*

# eve agent build output and local Vercel link state under apps/agent
.eve/
.vercel/
.output/
.nitro/
