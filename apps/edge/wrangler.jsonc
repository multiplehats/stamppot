{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stamppot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "stamppot.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
