# Vercel AI Gateway key for the agent model and the eval judge. `eve link` can
# pull a VERCEL_OIDC_TOKEN into .env.local instead. Never commit a real value.
AI_GATEWAY_API_KEY=

# Where the Marktplaats MCP lives. Defaults to production when unset; use the
# local Worker from `pnpm dev` at the repository root during development.
STAMPPOT_MCP_URL=http://localhost:5173/mcp/marktplaats
